option "title" "Spending"
option "operating_currency" "TWD"

2020-01-01 custom "fava-extension" "beancount_agent_api"
2020-01-01 custom "fava-option" "currency-column" "61"
2020-01-01 custom "fava-option" "indent" "2"
2020-01-01 custom "fava-option" "default-file" "txns.beancount"

include "txns.beancount"

2026-01-01 open Assets:TW:Cash TWD
  name-zh: "錢包"
2026-01-01 open Assets:TW:Bank TWD
  name-zh: "銀行"
2026-01-01 open Assets:US:Bank USD
2026-01-01 open Liabilities:Card:Cathay TWD
  name-zh: "國泰卡"
2026-01-01 open Expenses:Daily:Groceries TWD
  name-zh: "日用/雜貨"
2026-01-01 open Expenses:Food:Dinner TWD,USD
  name-zh: "食物/晚餐"
2026-01-01 open Expenses:Travel USD
